# =====================================================
# APPLICATION SETTINGS
# =====================================================
VITE_APP_TITLE=PulseBoard
VITE_APP_ENV=development
VITE_APP_VERSION=0.1.0

# =====================================================
# API SETTINGS
# =====================================================
VITE_API_BASE_URL=http://localhost:3000/api

# =====================================================
# SUPABASE CONFIGURATION
# =====================================================
# Leave these as placeholders to run in local demo auth mode.
# Replace with real values from Supabase Project Settings > API when ready.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Project Settings > API > Project API keys > anon public
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ⚠️ NEVER expose service_role key in frontend!
# This should only be used in backend/server-side code
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# =====================================================
# FEATURE FLAGS
# =====================================================
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_REALTIME=true
VITE_ENABLE_DEBUG=false

# =====================================================
# OPTIONAL: THIRD-PARTY INTEGRATIONS
# =====================================================
# VITE_SENTRY_DSN=
# VITE_GOOGLE_ANALYTICS_ID=

